#!/usr/bin/env bash
# Build the live bridge (MelonMCP) from pinned source; never downloads a binary.
# Usage: tools/bridge-build [--deploy]
#   clones elliotttate/MelonMCP at $PIN into tools/.bin/MelonMCP-<sha>/ (once),
#   refuses unless the only listener in the source is TcpListener(IPAddress.Loopback, ...),
#   builds it through a wrapper csproj against our MelonLoader net6 refs (Directory.Build.props),
#   --deploy copies MelonMCP.dll to <game>/Mods (refuses while the game runs).
# GAME_DIR overrides the game folder.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
game="${GAME_DIR:-/c/Program Files (x86)/Steam/steamapps/common/The Spell Brigade}"
repo=https://github.com/elliotttate/MelonMCP
PIN=ce87f4f7828903c9f4d61f05d87da4334f69f021
bin="$root/tools/.bin"
src="$bin/MelonMCP-${PIN:0:10}"
wrap="$bin/MelonMCP-build"

if [ ! -d "$src/.git" ]; then
  tmp="$(mktemp -d -p "$bin" MelonMCP-tmp.XXXX)"
  git -C "$tmp" init -q
  git -C "$tmp" fetch -q --depth 1 "$repo" "$PIN"
  git -C "$tmp" checkout -q FETCH_HEAD
  mv "$tmp" "$src"
fi
head="$(git -C "$src" rev-parse HEAD)"
[ "$head" = "$PIN" ] || { echo "bridge-build: $src is at $head, want $PIN" >&2; exit 1; }
git -C "$src" diff --quiet || { echo "bridge-build: $src has local changes" >&2; exit 1; }

# Bind guard: exactly one listener, on loopback.
listeners="$(grep -rnE 'new (TcpListener|HttpListener|UdpClient|Socket)\(' "$src/MelonMCP" || true)"
n="$(printf '%s\n' "$listeners" | grep -c . || true)"
if [ "$n" -ne 1 ] || ! printf '%s' "$listeners" | grep -q 'new TcpListener(IPAddress.Loopback,'; then
  echo "bridge-build: expected one TcpListener(IPAddress.Loopback, ...), found:" >&2
  printf '%s\n' "$listeners" >&2; exit 1
fi
echo "bridge-build: bind ok: ${listeners#"$src/"}"

mkdir -p "$wrap"
cat > "$wrap/MelonMCP.csproj" <<EOF
<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generated by tools/bridge-build; compiles MelonMCP @ ${PIN:0:10} unmodified. -->
  <PropertyGroup>
    <AssemblyName>MelonMCP</AssemblyName>
    <RootNamespace>MelonMCP</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <NoWarn>\$(NoWarn);CS0168;CS0219;CS0414;CS0649;CS1998;CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(cygpath -m "$src")/MelonMCP/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Newtonsoft.Json"><HintPath>\$(MelonNet6)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
EOF
dotnet build "$wrap/MelonMCP.csproj" -c Release -nologo -v q
dll="$wrap/bin/Release/net6.0/MelonMCP.dll"
[ -f "$dll" ] || { echo "bridge-build: $dll not built" >&2; exit 1; }
echo "bridge-build: $dll"

if [ "${1:-}" = "--deploy" ]; then
  if tasklist //FI "IMAGENAME eq TheSpellBrigade.exe" 2>/dev/null | grep -qi thespell; then
    echo "bridge-build: the game is running; close it first (DLLs are locked)" >&2; exit 1
  fi
  mkdir -p "$game/Mods"
  cp "$dll" "$game/Mods/"
  echo "bridge-build: MelonMCP.dll -> $game/Mods"
fi
