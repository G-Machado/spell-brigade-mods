#!/usr/bin/env bash
# Regenerate docs/game-map/: Cpp2IL dummy DLLs (signatures + [Address] RVAs) -> ilspycmd -p per game assembly.
#
# Source of the dummy DLLs, in order:
#   CPP2IL=<exe>   run that Cpp2IL standalone (--output-as dummydll, attributeinjector)
#   default        MelonLoader's own Cpp2IL output from interop generation (same Cpp2IL build,
#                  regenerated by ML whenever GameAssembly.dll changes: launch the game once first)
# GAME_DIR overrides the game folder.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
game="${GAME_DIR:-/c/Program Files (x86)/Steam/steamapps/common/The Spell Brigade}"
out="$root/docs/game-map"
work="$root/tools/.bin/dump-work"
asms=(Assembly-CSharp GameContracts Networking.EOS Networking.Shared Networking.Steam Networking.Switch Runtime)

command -v ilspycmd >/dev/null || { echo "dump: ilspycmd not on PATH" >&2; exit 1; }
rm -rf "$work" "$out"; mkdir -p "$work" "$out"

if [ -n "${CPP2IL:-}" ]; then
  src="$work/dummy"; via="$(basename "$CPP2IL")"
  "$CPP2IL" --game-path "$game" --exe-name TheSpellBrigade \
    --output-as dummydll --use-processor attributeinjector --output-to "$src" > "$work/cpp2il.log" 2>&1
else
  src="$game/MelonLoader/Dependencies/Il2CppAssemblyGenerator/Cpp2IL/cpp2il_out"
  via="MelonLoader cpp2il_out ($(grep -o 'DumperVersion = "[^"]*"' "$game/MelonLoader/Dependencies/Il2CppAssemblyGenerator/Config.cfg" | cut -d'"' -f2))"
fi
[ -d "$src" ] || { echo "dump: no dummy DLLs at $src" >&2; exit 1; }

n=0
for a in "${asms[@]}"; do
  [ -f "$src/$a.dll" ] || { echo "dump: missing $a.dll" >&2; continue; }
  ilspycmd -p -o "$out/$a" "$src/$a.dll" > "$work/ilspy-$a.log" 2>&1 || { echo "dump: ilspycmd failed on $a" >&2; continue; }
  n=$((n+1))
done
[ "$n" -gt 0 ] || { echo "dump: 0 assemblies decompiled" >&2; exit 1; }

rvas="$(grep -rh 'Address(RVA' --include=*.cs "$out" | wc -l)"
[ "$rvas" -gt 0 ] || { echo "dump: no [Address(RVA)] attributes; dummy DLLs lack the attribute injector" >&2; exit 1; }

build="$(grep -o '"buildid"[[:space:]]*"[0-9]*"' "$game/../../appmanifest_2904000.acf" 2>/dev/null | grep -o '[0-9]*' | tail -1 || true)"
{ echo "build=${build:-unknown}"; echo "generated=$(date -u +%Y-%m-%dT%H:%M:%SZ)"; echo "source=$via"
  echo "assemblies=$n"; echo "rva_attrs=$rvas"; } > "$out/BUILD"
echo "dump: $n assemblies, $rvas RVAs -> $out ($(du -sh "$out" | cut -f1), $(find "$out" -name '*.cs' | wc -l) .cs)"
